# ---------------------------------------------------------------------------
# Meta / WhatsApp Cloud API
# ---------------------------------------------------------------------------
# Token permanente del System User (Meta Business Suite > Usuarios del sistema)
WHATSAPP_TOKEN=

# ID del número de teléfono (Meta for Developers > WhatsApp > Configuración de la API)
WHATSAPP_PHONE_NUMBER_ID=

# Cadena que tú inventas. La escribes aquí Y en el panel de Meta al configurar
# el webhook. Meta la devuelve en el GET de verificación.
WHATSAPP_VERIFY_TOKEN=

# "Clave secreta de la aplicación" (App Secret) de Meta for Developers.
# Se usa para validar la firma X-Hub-Signature-256 de cada webhook.
WHATSAPP_APP_SECRET=

# Versión de la Graph API. Súbela solo cuando hayas probado el cambio.
WHATSAPP_API_VERSION=v23.0

# ---------------------------------------------------------------------------
# Claude (Anthropic)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max. En un chatbot conviene "low" por latencia.
ANTHROPIC_EFFORT=low

# ---------------------------------------------------------------------------
# Supabase (opcional)
# ---------------------------------------------------------------------------
# Si las dejas vacías, el bot funciona igual pero guarda el historial en memoria
# (se pierde en cada arranque). Úsalo solo para desarrollo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Comportamiento del agente
# ---------------------------------------------------------------------------
# Minutos que el bot permanece callado después de que tú escribes manualmente
# desde la app de WhatsApp Business (handoff a humano).
HUMAN_TAKEOVER_MINUTES=60

# Número de mensajes previos que se envían a Claude como contexto.
HISTORY_LIMIT=20

# Zona horaria para saludos y horarios de atención.
TIMEZONE=America/Bogota
